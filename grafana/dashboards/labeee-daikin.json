      "pluginVersion": "13.2.1",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "import \"strings\"\n// Estado atual de cada ar-condicionado (o HA publica a cada 10 min e a cada mudança)\nfrom(bucket: \"LabEEE\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"daikin\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: string(v: r._value)}))\n  |> map(fn: (r) => ({r with local:\n      if r.unidade == \"1_02\" then \"Salão · mesas 51–54/61–64\"\n      else if r.unidade == \"1_03\" then \"Salão · mesas 31–34/41–44\"\n      else if r.unidade == \"1_04\" then \"Salão · mesas 11–14/21–24\"\n      else if r.unidade == \"1_05\" then \"Salão · mesas 35–37/45–47\"\n      else if r.unidade == \"1_06\" then \"Salão · mesas 15–17/25–27\"\n      else if r.unidade == \"1_00\" then \"Reunião 1\"\n      else if r.unidade == \"1_01\" then \"Reunião 2\"\n      else if r.unidade == \"1_07\" then \"Sala da Ana Paula\"\n      else if r.unidade == \"1_08\" then \"Sala do Lamberts\"\n      else \"?\"}))\n  |> map(fn: (r) => ({r with unidade: \"Daikin \" + strings.replaceAll(v: r.unidade, t: \"_\", u: \"-\")}))\n  |> group()\n  |> pivot(rowKey: [\"unidade\", \"local\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"unidade\", \"local\", \"ligado\", \"modo\", \"setpoint\", \"temp_retorno\", \"ventilador\", \"filtro_sujo\"])\n  |> sort(columns: [\"unidade\"])",
          "refId": "A"
        }
      ],
      "title": "Estado atual dos ares-condicionados",
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "destinationType": "number",
                "targetField": "ligado"
              },
              {
                "destinationType": "number",
                "targetField": "setpoint"
              },
              {
                "destinationType": "number",
                "targetField": "temp_retorno"
              },
              {
                "destinationType": "number",
                "targetField": "filtro_sujo"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "filtro_sujo": 7,
              "ligado": 2,
              "local": 1,
              "modo": 3,
              "setpoint": 4,
              "temp_retorno": 5,
              "unidade": 0,
              "ventilador": 6
            },
            "renameByName": {
              "filtro_sujo": "Filtro",
              "ligado": "Estado",
              "local": "Local",
              "modo": "Modo",
              "setpoint": "Setpoint",
              "temp_retorno": "Temp. de retorno",
              "unidade": "Unidade",
              "ventilador": "Ventilador"
            }
          }
        }
      ],
      "type": "table"
