      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "import \"array\"\n// Minutos desde o último dado de cada fonte. Mais de 30 min = algo parou (HA, MQTT ou Telegraf).\nfontes = array.from(rows: [\n  {m: \"ambiente\", fonte: \"HOBO (temperatura / CO₂)\"},\n  {m: \"zigbee\", fonte: \"Sensores Zigbee (janelas)\"},\n  {m: \"janela\", fonte: \"Janelas (estado a cada 10 min)\"},\n  {m: \"presenca\", fonte: \"Presença dos PCs\"},\n  {m: \"daikin\", fonte: \"Ar-condicionado Daikin\"}])\nultimo = from(bucket: \"LabEEE\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => (r._measurement == \"ambiente\" and r._field == \"temp_c\") or (r._measurement == \"zigbee\" and r._field == \"linkquality\") or (r._measurement == \"janela\" and r._field == \"aberta\") or (r._measurement == \"presenca\" and r._field == \"presente\") or (r._measurement == \"daikin\" and r._field == \"ligado\"))\n  |> group(columns: [\"_measurement\"])\n  |> last()\n  |> group()\n  |> map(fn: (r) => ({m: r._measurement, min: float(v: int(v: now()) - int(v: r._time)) / 60000000000.0}))\njoin(tables: {f: fontes, u: ultimo}, on: [\"m\"], method: \"inner\") |> keep(columns: [\"fonte\", \"min\"]) |> sort(columns: [\"fonte\"])",
          "refId": "A"
        }
      ],
      "title": "Minutos desde o último dado, por fonte",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "fonte": "Fonte",
              "min": "Último dado (min atrás)"
            }
          }
        }
      ],
      "type": "table"
    },
