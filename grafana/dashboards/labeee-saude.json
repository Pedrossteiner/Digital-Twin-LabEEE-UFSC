          "query": "import \"strings\"\nfrom(bucket: \"LabEEE\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"zigbee_disponibilidade\")\n  |> group(columns: [\"topic\"]) |> last() |> group()\n  |> filter(fn: (r) => r.topic !~ /0x/)\n  |> filter(fn: (r) => strings.containsStr(v: string(v: r._value), substr: \"offline\"))\n  |> map(fn: (r) => ({sensor: strings.trimSuffix(v: strings.trimPrefix(v: r.topic, prefix: \"zigbee2mqtt/\"), suffix: \"/availability\"), desde: r._time}))\n  |> count(column: \"sensor\")",
          "refId": "A"
        }
      ],
