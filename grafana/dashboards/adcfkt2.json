          "query": "// Nome de cada série: bancada (grupo de mesas do Shelly) + número de série do HOBO.\nbancada = (s) =>\n  if s == \"20590561\" or s == \"20589706\" or s == \"20589709\" or s == \"20589716\" then \"Mesas 51–54/61–64\"\n  else if s == \"20590559\" or s == \"20589722\" or s == \"20589732\" or s == \"20589744\" then \"Mesas 31–34/41–44\"\n  else if s == \"20590562\" or s == \"20589717\" or s == \"20589733\" or s == \"20589763\" then \"Mesas 11–14/21–24\"\n  else if s == \"20590564\" or s == \"20589702\" or s == \"20589725\" or s == \"20589761\" then \"Mesas 15–17/25–27\"\n  else if s == \"20590558\" or s == \"20589721\" or s == \"20589729\" or s == \"20589766\" then \"Mesas 35–37/45–47\"\n  else \"Sem bancada\"\nfrom(bucket: \"LabEEE\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ambiente\" and r._field == \"co2_ppm\")\n  |> map(fn: (r) => ({_time: r._time, _value: float(v: r._value), nome: bancada(s: r.serie) + \" · \" + r.serie}))\n  |> group(columns: [\"nome\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
